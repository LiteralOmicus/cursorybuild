# Uncomment this line to define a global platform for your project
platform :ios, '14.0' # Set your minimum iOS deployment target here.
# Note: It's best practice to match this with your project's IPHONEOS_DEPLOYMENT_TARGET.
# I've set it to '14.0' for compatibility, you should adjust as needed.

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# The standard, correct way to integrate Flutter pods using the official podhelper.rb
flutter_application_path = File.join(__dir__, '..')
load File.join(flutter_application_path, '.ios', 'Flutter', 'podhelper.rb') # Standard, correct path

# This block is required by Flutter's podhelper.rb to set up the build system.
target 'Runner' do
  use_frameworks!
  use_modular_headers! # Recommended for many modern pods

  # Flutter Pods - these are automatically added by Flutter based on your pubspec.yaml plugins
  # This command is the correct way to include all Flutter-managed pods.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Add any other custom pods here if you have them, e.g.:
  # pod 'AnotherSDK', '~> 1.0'
end

# Standard post_install to apply Flutter-required build settings to targets.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply essential build settings for Flutter
    flutter_additional_ios_build_settings(target)

    # Re-enable this section if you need to manually set SWIFT_VERSION for a specific pod.
    # if target.name == 'RecaptchaInterop'
    #   target.build_configurations.each do |config|
    #     config.build_settings['SWIFT_VERSION'] = '5.0'
    #   end
    # end
  end
end
