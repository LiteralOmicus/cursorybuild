# Uncomment this line to define a global platform for your project
platform :ios, '18.0' 

# Note: Your platform is set to 18.0, but IPHONEOS_DEPLOYMENT_TARGET is 14.0 below.
# I recommend setting this to your minimum deployment target, e.g., '14.0'.

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# (The flutter_root and require... blocks are standard and should be left as is)

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig not found at #{generated_xcode_build_settings_path}. Try running `flutter pub get` first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run `flutter pub get`"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup do |installer|
  # This block is for Flutter's internal pod setup.
end

target 'Runner' do
  use_frameworks!
  use_modular_headers! # Recommended for many modern pods
  
  # --- BEGIN INTEGRATION ---
  
  # The essential line that installs ALL Flutter plugins
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # **NEW LINE:** Explicitly define the problematic pod.
  # This ensures CocoaPods processes it with the 'Runner' target's settings (like use_frameworks!).
  pod 'webview_flutter_wkwebview' 
  
  # --- END INTEGRATION ---

  # Add any other custom pods here if you have them
end

# (The post_install block is for advanced settings and should be left as is)
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    if target.name.include?('privacy')
      puts "Applying aggressive workaround to skip CopySwiftLibs for #{target.name}"
      target.build_phases.each do |build_phase|
        if build_phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) && build_phase.name == 'CopySwiftLibs'
          build_phase.shell_script = 'exit 0'
          puts "  - Found and disabled CopySwiftLibs script phase for #{target.name}."
          break
        end
      end
    end
    
    if target.name == 'RecaptchaInterop'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
  end
end
