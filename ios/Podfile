# Podfile for a Clean Flutter iOS Project
# Designed to work with a CI system that runs 'flutter pub get' and 'pod install'.

platform :ios, '18.0' # Set your minimum iOS deployment target. Ensure this matches your project's settings.

# Recommended best practice to silence CocoaPods stats, improving CI speed.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# --- Flutter Integration ---
# These lines load the necessary script generated by `flutter pub get`.
# The flutter_application_path points to the root of your Flutter project (../).

flutter_application_path = File.join(__dir__, '..')
load File.join(flutter_application_path, '.ios', 'Flutter', 'podhelper.rb') # Standard path to the generated helper script

# --- Target Definition ---
target 'Runner' do
  # Essential settings for modern CocoaPods integration
  use_frameworks!
  use_modular_headers!

  # This crucial command integrates all pods required by your Flutter plugins (from pubspec.yaml)
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Add any custom, non-plugin-related pods here if needed, e.g.:
  # pod 'Firebase/Analytics'
end

# --- Post-Install Hook ---
# This hook is required by Flutter to apply essential build settings (like code signing options)
# to all plugin pods, ensuring compatibility with the main Runner target.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Note: If you have specific build issues, this is where you would apply
    # targeted settings, but this clean version leaves only the essential Flutter hook.
  end
end
