  #flutter_additional_pods(flutter_application_path)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
    if target.name != 'Runner'
      target.build_configurations.each do |config|
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
        config.build_settings['PROVISIONING_PROFILE'] = ''
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      end
    end

    # List of *executable-free* bundles that fail CopySwiftLibs
    failing_bundle_targets = [
      'google_mobile_ads-google_mobile_ads', # Already fixed, keep for safety
      'webview_flutter_wkwebview-webview_flutter_wkwebview' # Keep this primary plugin target
    ]

    target.build_configurations.each do |config|
      
      # 🛑 CRITICAL FIX: Add a guard clause here to prevent the 'undefined method' error.
      if target.is_a?(Xcodeproj::Project::Object::PBXNativeTarget)
        # FIX A: RESOURCE BUNDLES (This handles targets like *_privacy bundles)
        if target.name.include?('_privacy') || target.name.end_with?('_Privacy') || target.product_type == 'com.apple.product-type.bundle'
          config.build_settings['PRODUCT_TYPE'] = 'com.apple.product-type.bundle'
          # CRITICAL: Ensures no Swift linking is attempted on resource bundles
          config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO' 
          config.build_settings['EXECUTABLE_NAME'] = '' 
        end
      end # <--- NEW 'end' for the PBXNativeTarget check

      # FIX B: PRIMARY PLUGIN BUNDLES (Force Static Lib on known culprits)
      if failing_bundle_targets.include?(target.name)
        config.build_settings['MACH_O_TYPE'] = 'staticlib' 
        config.build_settings['DEFINES_MODULE'] = 'YES'
      end
    end

    # 🛑 THE DEFINITIVE FIX: Remove the failing build phase for all non-executable bundles.
    # Check if the target is a known failure or a privacy bundle
    if failing_bundle_targets.include?(target.name) || target.name.include?('_privacy') 
      target.build_phases.delete_if do |phase|
        # Check by command or display name
        (phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) && phase.shell_script.include?('builtin-swiftStdLibTool')) ||
        (phase.display_name == 'Copy Swift Standard Libraries')
      end
      puts "SUCCESS: Cleaned CopySwiftLibs phase from target: #{target.name}"
    end

  end
  installer.pods_project.save
end

