project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig not found at #{generated_xcode_build_settings_path}. Try running `flutter pub get` first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run `flutter pub get`"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup do |installer|
  # This block is for Flutter's internal pod setup.
  # You generally don't need to add anything here unless explicitly required by a plugin.
end

target 'Runner' do
  use_frameworks!
  use_modular_headers! # Recommended for many modern pods
  
  # Flutter Pods - these are automatically added by Flutter based on your pubspec.yaml plugins
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Add any other custom pods here if you have them, e.g.:
  # pod 'AnotherSDK', '~> 1.0'
  #flutter_additional_pods(flutter_application_path)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      
      # FIX FOR ALL TARGETS (Optional but good practice)
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      # ==========================================================
      # FIX 1: PRIVACY/RESOURCE BUNDLES (Previous successful fix)
      if target.name.include?('_privacy') || target.name.end_with?('_Privacy')
        config.build_settings['PRODUCT_TYPE'] = 'com.apple.product-type.bundle'
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO'
        config.build_settings['EXECUTABLE_NAME'] = '' # Clears the expected executable path
      end
      # ==========================================================
      
      # ==========================================================
      # FIX 2: PRIMARY PLUGIN BUNDLES (NEW FIX for google_mobile_ads)
      # Force the failing plugin targets to be compiled as static libraries, 
      # eliminating the CopySwiftLibs dependency entirely.
      if ['google_mobile_ads', 'webview_flutter_wkwebview'].include?(target.name)
        # Force compilation as a static library
        config.build_settings['MACH_O_TYPE'] = 'staticlib' 
        # Ensure it defines a module (required for Swift/Objective-C interop)
        config.build_settings['DEFINES_MODULE'] = 'YES'
        # Disable strict messaging often needed when mixing static/dynamic libs
        config.build_settings['ENABLE_STRICT_OBJC_MSGSEND'] = 'NO' 
      end
      # ==========================================================
      
    end
  end
end
