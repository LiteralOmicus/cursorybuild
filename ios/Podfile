# Uncomment this line to define a global platform for your project
# platform :ios, '12.0' # Adjust this if your app supports an older iOS version
platform :ios, '14.0' # Set to 14.0 or higher as per your xcodebuild command

# CocoaPods analytics sends network requests when CocoaPods is used.
# For more information, see https://guides.cocoapods.org/syntax/podfile.html#install_all_pods_from_source
# or to disable it completely, use `export COCOAPODS_DISABLE_STATS=1` in your shell.
install! 'cocoapods',
         :disable_input_output_paths => true

# This Flutter line is crucial and should be present in your Podfile
flutter_application_path = File.join(__dir__, '..')
# CORRECTED LINE BELOW: Changed '.ios' to 'ios'
load File.join(flutter_application_path, 'ios', 'Flutter', 'podhelper.rb')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Pods for Runner
  pod 'FirebaseCoreOnly', :modular_headers => true
  # Add any other specific pods you have here, e.g.,
  # pod 'path_provider_foundation'
  # pod 'webview_flutter_wkwebview'
  # pod 'audio_session' # If you add it manually, otherwise Flutter adds it

  flutter_additional_pods(flutter_application_path)
end

# IMPORTANT: Add the post_install hook below this line,
# after the 'target 'Runner' do ... end' block.

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Keep your existing deployment target setting
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      # And potentially this, if it helps other pods (from previous troubleshooting)
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'

      # --- NEW LOGIC TO HANDLE PRIVACY BUNDLES ---
      # This block identifies targets ending with '_privacy' (or containing '_privacy-')
      # and sets their build settings to correctly define them as resource bundles.
      if target.name.end_with?('_privacy') || target.name.include?('_privacy-')
        puts "Adjusting build settings for privacy bundle target: #{target.name}"
        config.build_settings['DEFINES_MODULE'] = 'NO' # Not a module-defining target
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO' # Does not contain embeddable Swift code
        config.build_settings['MACH_O_TYPE'] = 'none' # Explicitly state it produces no Mach-O executable
        config.build_settings['CODE_SIGN_IDENTITY'] = '' # No code signing needed for resource bundles
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      end
      # --- END NEW LOGIC ---
    end
  end
end
