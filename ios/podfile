# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # PDFTron Pods
  use_frameworks!
  pod 'PDFTron', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron/latest.podspec'
  pod 'PDFTronTools', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron-tools/latest.podspec'
end

# This block runs after all pods have been installed.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply Flutter's default build settings
    flutter_additional_ios_build_settings(target)

    # Disable ENABLE_BITCODE for all targets (as per your existing setting)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end

    # --- Aggressive fix: Attempt to disable Swift embedding for the privacy bundle target ---
    if target.name == 'webview_flutter_wkwebview-webview_flutter_wkwebview_privacy'
      puts "--- Applying aggressive fix: Disabling Swift embedding & clearing related paths for target: #{target.name} ---"
      target.build_configurations.each do |config|
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO'
        config.build_settings['PRODUCT_TYPE'] = 'com.apple.product-type.bundle' # Ensure it's explicitly a bundle
        config.build_settings['SKIP_INSTALL'] = 'YES' # Re-add, as it might interact with other flags

        # Explicitly clear Swift-related search paths and run paths
        config.build_settings['LIBRARY_SEARCH_PATHS'] = ''
        config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = ''
        config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '' # Clear any conditions that might imply Swift
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '' # Clear Swift optimization levels
        config.build_settings['SWIFT_INCLUDE_PATHS'] = '' # Clear Swift include paths
        config.build_settings['SWIFT_WHOLE_MODULE_OPTIMIZATION'] = 'NO' # Explicitly disable

        # Ensure correct device family settings, preventing macOS/Catalyst interpretations
        config.build_settings['SUPPORTS_MACCATALYST'] = 'NO'
        config.build_settings['TARGETED_DEVICE_FAMILY'] = '1,2' # iPhone, iPad

        puts "  - Applied extensive NO/empty settings for #{config.name}"
      end
      puts "--- Finished applying aggressive fix for target: #{target.name} ---"
    end
    # --- End aggressive fix ---

  end
end
