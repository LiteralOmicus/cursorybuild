# Uncomment this line to define a global platform for your project
platform :ios, '13.0' # Or your desired minimum iOS version

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# This line sets FLUTTER_ROOT and other essential variables from Flutter's generated build settings.
# It effectively replaces the need for a direct `require` to `podhelper.rb` in many cases,
# as `flutter_ios_podfile_setup` will then find the helper.
require_relative 'Flutter/Generated.xcconfig'

target 'Runner' do
  use_frameworks! # Recommended for Swift and dynamic frameworks
  use_modular_headers! # Improves build times and handles modular dependencies better

  # This function, defined by Flutter's internal podhelper (loaded via Generated.xcconfig),
  # installs pods for your Flutter plugins based on pubspec.yaml.
  flutter_ios_podfile_setup

  # PDFTron Pods - Make sure these are the correct podspecs for your needs.
  pod 'PDFTron', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron/latest.podspec'
  pod 'PDFTronTools', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron-tools/latest.podspec'
end

post_install do |installer|
  # This function is part of Flutter's podhelper and applies standard build settings
  # to all pod targets (e.g., Swift version, bitcode settings).
  flutter_post_install(installer) if defined?(flutter_post_install)

  installer.pods_project.targets.each do |target|
    # Disable ENABLE_BITCODE for all targets (as per your common requirement)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end

  # Crucial: Save the modified project
  installer.pods_project.save
end
