# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # PDFTron Pods
  use_frameworks!
  pod 'PDFTron', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron/latest.podspec'
  pod 'PDFTronTools', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron-tools/latest.podspec'
end

# This block runs after all pods have been installed.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply Flutter's default build settings
    flutter_additional_ios_build_settings(target)

    # Disable ENABLE_BITCODE for all targets (as per your existing setting)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end

    # --- Aggressive fix: Address CopySwiftLibs and bundle type issues for webview_flutter_wkwebview_privacy ---
    if target.name == 'webview_flutter_wkwebview-webview_flutter_wkwebview_privacy'
      puts "--- Applying aggressive fix for target: #{target.name} ---"
      
      # It's crucial to ensure this target is treated purely as a resource bundle
      # and not as something that needs Swift linking or embedding.

      target.build_phases.dup.each do |phase|
        # Remove any Swift-related build phases if they exist
        if phase.is_a?(Xcodeproj::Project::Object::PBXCopyFilesBuildPhase) && phase.name == 'CopySwiftLibs'
          puts "  - Removing CopySwiftLibs build phase from #{target.name}"
          target.build_phases.delete(phase)
        elsif phase.is_a?(Xcodeproj::Project::Object::PBXFrameworksBuildPhase)
          puts "  - Removing Frameworks build phase from #{target.name} (not needed for resource bundle)"
          target.build_phases.delete(phase)
        elsif phase.is_a?(Xcodeproj::Project::Object::PBXSourcesBuildPhase)
          puts "  - Removing Sources build phase from #{target.name} (not needed for resource bundle)"
          target.build_phases.delete(phase)
        end
      end

      target.build_configurations.each do |config|
        puts "  - Applying specific build settings for #{config.name} in #{target.name}"
        config.build_settings['PRODUCT_TYPE'] = 'com.apple.product-type.bundle'
        config.build_settings['SKIP_INSTALL'] = 'YES'
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO'
        
        # Explicitly disable code signing for this bundle, as it's not an executable
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'

        # Ensure no executable name is set for this bundle
        config.build_settings['EXECUTABLE_NAME'] = ''
        config.build_settings['MACH_O_TYPE'] = 'none' # Explicitly state no Mach-O executable
        config.build_settings['WRAPPER_EXTENSION'] = 'bundle' # Ensure correct extension

        # Explicitly clear any Swift-related settings that might trigger CopySwiftLibs
        # These are crucial for preventing implicit Swift linking/embedding
        config.build_settings['SWIFT_VERSION'] = '' # Clear Swift version if set
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = ''
        config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = ''
        config.build_settings['SWIFT_INCLUDE_PATHS'] = ''
        config.build_settings['DEFINES_MODULE'] = 'NO' # Not a module to define
        
        # Completely remove these keys if they exist, rather than setting to empty string
        # This is more forceful and prevents Xcode from trying to infer paths
        config.build_settings.delete('LD_RUNPATH_SEARCH_PATHS')
        config.build_settings.delete('DYLIB_INSTALL_NAME_BASE')
        config.build_settings.delete('LIBRARY_SEARCH_PATHS') # Also remove library search paths

        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO' # Suppress warnings
        config.build_settings['TARGETED_DEVICE_FAMILY'] = '1,2' # Ensure iOS device family
        config.build_settings['SUPPORTS_MACCATALYST'] = 'NO' # Explicitly disable Mac Catalyst support
      end
      puts "--- Finished aggressive fix for target: #{target.name} ---"
    end
    # --- End aggressive fix ---
  end
  # Crucial: Save the modified project
  installer.pods_project.save
end
