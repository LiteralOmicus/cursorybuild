# Uncomment this line to define a global platform for your project
platform :ios, '13.0' # Flutter often defaults to 13.0 or higher, keep as is.

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# This line is essential for Flutter's build system integration with CocoaPods.
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Sets up Flutter's default Podfile configurations before your target definitions.
flutter_ios_podfile_setup

target 'Runner' do
  # This installs all Flutter plugin pods. Do not remove this line.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # PDFTron Pods - Keep these as they are explicitly added by you.
  use_frameworks! # Required for PDFTron
  pod 'PDFTron', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron/latest.podspec'
  pod 'PDFTronTools', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron-tools/latest.podspec'

  # Add any other specific pods your project needs here, for example:
  # pod 'AnotherPod', '~> 1.0.0'
end

# This block runs after all pods have been installed.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Always apply Flutter's default build settings first for all targets.
    # This ensures Flutter's internal requirements are met for all pods.
    flutter_additional_ios_build_settings(target)

    # Disable ENABLE_BITCODE for all targets.
    # This is a common practice in Flutter/iOS development, especially with third-party libraries,
    # as Bitcode can sometimes cause issues or is not required for app store submission anymore.
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end

    # --- START: Targeted fix for resource bundles with PrivacyInfo.xcprivacy ---
    # This section specifically targets resource bundle targets (which often end with '_privacy'
    # or similar suffixes for PrivacyInfo.xcprivacy files) that are incorrectly
    # having Swift linking phases applied.
    # These bundles are *not* intended to contain executable Swift code.
    # The fix removes the 'Copy Swift Standard Libraries' build phase and
    # ensures Xcode doesn't try to embed Swift for these targets.
    if target.name.end_with?('_privacy') || target.name.include?('webview_flutter_wkwebview_privacy') || target.name.include?('shared_preferences_foundation_privacy') || target.name.include?('path_provider_foundation_privacy') || target.name.include?('flutter_native_splash_privacy') || target.name.include?('image_picker_ios_privacy') || target.name.include?('GoogleUtilities_Privacy') || target.name.include?('GTMSessionFetcher_Core_Privacy') || target.name.include?('FirebaseCoreInternal_Privacy') || target.name.include?('FirebaseCoreExtension_Privacy') || target.name.include?('FirebaseCore_Privacy') || target.name.include?('FirebaseAuth_Privacy') || target.name.include?('leveldb_Privacy')
      puts "Applying resource bundle fix for target: #{target.name}"
      target.build_phases.each do |build_phase|
        # Check if the build phase is a shell script phase and its name indicates Swift library copying
        if build_phase.isa == 'PBXShellScriptBuildPhase' && build_phase.name == 'Copy Swift Standard Libraries'
          puts "  - Removing 'Copy Swift Standard Libraries' build phase from #{target.name}."
          build_phase.remove_from_project
        end
      end
      # Also ensure that Xcode doesn't try to embed Swift for these resource bundles
      target.build_configurations.each do |config|
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO'
        # Ensure runpath search paths are standard, not trying to find Swift dylibs for this bundle
        config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = '$(inherited) @executable_path/Frameworks'
      end
    end
    # --- END: Targeted fix for resource bundles with PrivacyInfo.xcprivacy ---
  end

  # CRITICAL: Save the modified project.
  # This line ensures that any changes made in the post_install block are written back to the .xcodeproj file.
  installer.pods_project.save
end
