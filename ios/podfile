name: Deploy Flutter iOS to TestFlight (No Mac Local)

on:
  push:
    branches:
      - main # Or the branch you push to for releases
  workflow_dispatch: # Allows manual trigger from GitHub Actions tab

jobs:
  build_and_deploy_ios:
    runs-on: macos-latest # This IS your virtual Mac!
    env:
      # WARNING: Setting ACTIONS_ALLOW_UNSECURE_COMMANDS to 'true' is generally
      # not recommended for production workflows due to security implications.
      # Use with caution and only if absolutely necessary for specific actions.
      ACTIONS_ALLOW_UNSECURE_COMMANDS: 'true' 

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.22.x' # Use your specific Flutter version
          channel: 'stable'
          cache: true # Caches Flutter dependencies

      - name: Install dependencies
        run: flutter pub get

      - name: Install CocoaPods
        run: |
          gem install cocoapods
          cd ios && pod install --repo-update --no-repo-update

      - name: Create Temporary Keychain for Signing
        env:
          KEYCHAIN_PASSWORD: ${{ secrets.XCODE_TEMP_KEYCHAIN_PASSWORD }}
        run: |
          security create-keychain -p "$KEYCHAIN_PASSWORD" "${HOME}/Library/Keychains/build.keychain"
          security default-keychain -s "${HOME}/Library/Keychains/build.keychain"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "${HOME}/Library/Keychains/build.keychain"
          security set-keychain-settings -t 3600 -l "${HOME}/Library/Keychains/build.keychain"
          echo "Temporary keychain created and unlocked."

      - name: Configure App Store Connect API Key for Xcode CLI
        env:
          ASC_PRIVATE_KEY_CONTENT: ${{ secrets.ASC_PRIVATE_KEY_CONTENT }}
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
        run: |
          mkdir -p ~/private_keys
          echo "$ASC_PRIVATE_KEY_CONTENT" | base64 --decode > ~/private_keys/AuthKey_$ASC_KEY_ID.p8
          echo "App Store Connect API key saved to ~/private_keys/AuthKey_$ASC_KEY_ID.p8"

      - name: Build and Archive iOS App
        run: |
          flutter build ipa --release \
            --export-options-plist=ios/ExportOptions.plist \
            --build-number=$(git rev-list --count HEAD) \
            --build-name=1.0.0.$(git rev-list --count HEAD)
          
          ls -l build/ios/ipa/

      - name: Upload IPA to TestFlight
        run: |
          IPA_PATH=$(find build/ios/ipa -name "*.ipa")
          echo "Found IPA: $IPA_PATH"

          xcrun altool --upload-app \
            --type ios \
            --file "$IPA_PATH" \
            --apiKey "$ASC_KEY_ID" \
            --apiIssuer "$ASC_ISSUER_ID" \
            --verbose

          echo "Upload command executed. Check App Store Connect for processing status."
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}

      - name: Delete Temporary Keychain
        if: always()
        env:
          KEYCHAIN_PASSWORD: ${{ secrets.XCODE_TEMP_KEYCHAIN_PASSWORD }}
        run: |
          security delete-keychain "${HOME}/Library/Keychains/build.keychain"
          echo "Temporary keychain deleted."

      - name: Upload IPA artifact (Optional)
        uses: actions/upload-artifact@v4
        with:
          name: flutter-ios-app
          path: build/ios/ipa/*.ipa
          retention-days: 7
