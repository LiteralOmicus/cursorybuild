# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # PDFTron Pods
  use_frameworks!
  pod 'PDFTron', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron/latest.podspec'
  pod 'PDFTronTools', podspec: 'https://pdftron.com/downloads/ios/flutter/pdftron-tools/latest.podspec'
end

# This block runs after all pods have been installed.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply Flutter's default build settings
    flutter_additional_ios_build_settings(target)

    # Disable ENABLE_BITCODE for all targets (as per your existing setting)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end

    # --- Aggressive fix: Modify generated build phase script for webview_flutter_wkwebview_privacy bundle ---
    # This attempts to comment out the 'builtin-swiftStdLibTool' command in the generated script.
    if target.name == 'webview_flutter_wkwebview-webview_flutter_wkwebview_privacy'
      puts "--- Attempting to modify generated build script for target: #{target.name} ---"
      # Construct the expected path to the target's support files directory
      target_support_dir = File.join(installer.pods_project.path, 'Target Support Files', target.name)

      # Find the script file that likely contains the problematic command
      # The exact filename might vary, but it's often related to resources or frameworks.
      # We'll search all .sh files in the target support directory.
      script_file_pattern = File.join(target_support_dir, '*.sh')
      script_files = Dir.glob(script_file_pattern)

      if script_files.empty?
        puts "  - No .sh script files found in #{target_support_dir}. Cannot apply script modification fix."
      else
        modified_any_script = false
        script_files.each do |script_file|
          # Read the script file content
          script_content = File.read(script_file)

          # Check if the script contains the problematic command
          if script_content.include?('builtin-swiftStdLibTool')
            puts "  - Found 'builtin-swiftStdLibTool' in script: #{File.basename(script_file)}"
            # Comment out lines containing 'builtin-swiftStdLibTool'
            new_script_content = script_content.gsub(/^.*builtin-swiftStdLibTool.*$/, '# \0 # COMMENTED_OUT_BY_POST_INSTALL_FIX')

            # Write the modified content back to the file
            File.open(script_file, 'w') { |file| file.puts new_script_content }
            puts "  - Commented out 'builtin-swiftStdLibTool' command in #{File.basename(script_file)}"
            modified_any_script = true
          end
        end

        if !modified_any_script
           puts "  - 'builtin-swiftStdLibTool' command not found in any .sh scripts for #{target.name}. Script modification fix not applied."
        end
      end

      # Keep the build setting overrides as a backup/defensive measure
      target.build_configurations.each do |config|
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
        config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'NO'
        config.build_settings['PRODUCT_TYPE'] = 'com.apple.product-type.bundle'
        puts "  - Ensured build settings are NO/bundle for #{config.name}"
      end
      puts "--- Finished aggressive fix attempt for target: #{target.name} ---"
    end
    # --- End aggressive fix ---

  end
end
