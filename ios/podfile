# Podfile
# This file is used by CocoaPods to manage your iOS project's dependencies.
# It's located in the 'ios' directory of your Flutter project.

# Uncomment this line to define a global platform for your project
platform :ios, '13.0' # Adjust this to your minimum supported iOS version

# Flutter requires a minimum iOS version of 11.0 for the Runner target.
# You can override this in Xcode if needed, but ensure it's at least 11.0.

# Define the Flutter application's path
flutter_application_path = '../.symlinks/flutter/ios'
# This path points to where Flutter's iOS framework is located.

# Load Flutter-specific CocoaPods settings
load File.join(flutter_application_path, 'Flutter.podspec')

# Define the main target for your Flutter app
target 'Runner' do
  # Use frameworks for all pods. This is generally recommended for Flutter.
  use_frameworks!

  # Add any specific CocoaPods dependencies for your iOS project here.
  # For example, if you use Firebase or other native iOS libraries:
  # pod 'Firebase/Core'
  # pod 'GoogleSignIn'

  # This line ensures that Flutter's own dependencies are correctly linked.
  # It's generated by `flutter create` and should typically not be changed.
  flutter_install_all_ios_pods_into_project(
    :flutter_application_path => flutter_application_path
  )
end

# Post-install hook to ensure correct build settings for all pods.
# This is important for compatibility and to resolve potential build issues.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Optional: If you encounter issues with specific pods, you might need to
    # manually set their build settings, for example:
    # config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
    # config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FLUTTER_PRODUCTION=1' if config.name == 'Release'
  end
end
